# Local development defaults. Copy to .env and edit as needed.

# Postgres. The driver is chosen from this URL's scheme (src/lib/prisma-client.ts),
# and prisma/schema.prisma must name the matching provider.
# End hosted URLs with sslmode=verify-full, not sslmode=require — see DEPLOY.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# For local SQLite instead, set provider = "sqlite" in prisma/schema.prisma and use:
# DATABASE_URL="file:./prisma/dev.db"

# Signs the session cookie. MUST be replaced in any deployed environment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-replace-before-deploying"

# Used to build invite links.
APP_URL="http://localhost:3000"
