# Local development defaults. Copy to .env and edit as needed.

# SQLite for local dev. Swap to a postgres:// URL and change the provider
# in prisma/schema.prisma when you move to a hosted database.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. MUST be replaced in any deployed environment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-replace-before-deploying"

# Used to build invite links.
APP_URL="http://localhost:3000"
